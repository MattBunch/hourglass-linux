<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.MattBunch.Hourglass</id>
  <name>Hourglass</name>
  <summary>Simple timer for Linux</summary>
  <metadata_license>MIT</metadata_license>
  <project_license>MIT</project_license>
  <description>
    <p>Hourglass Linux is a native Avalonia-based port of the Hourglass timer, focused on fast countdown entry, visible remaining time, saved timers, audio alerts, desktop notifications, and Linux desktop integration.</p>
  </description>
  <developer id="io.github.mattbunch">
    <name>Matt Bunch</name>
  </developer>
  <url type="homepage">https://mattbunch.dev</url>
  <url type="vcs-browser">https://github.com/MattBunch/hourglass-linux</url>
  <url type="bugtracker">https://github.com/MattBunch/hourglass-linux/issues</url>
  <launchable type="desktop-id">io.github.MattBunch.Hourglass.desktop</launchable>
  <provides>
    <binary>hourglass-linux</binary>
  </provides>
