<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Hourglass.Linux.Avalonia"
        x:Class="Hourglass.Linux.Avalonia.ExitConfirmationWindow"
        Title="{x:Static local:ApplicationStrings.ExitConfirmationTitle}"
        Icon="/Assets/hourglass.png"
        Width="360"
        Height="150"
        CanResize="False"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
  <Grid Margin="20"
        RowDefinitions="*,Auto">
    <TextBlock Text="{x:Static local:ApplicationStrings.ExitConfirmationMessage}"
               AutomationProperties.Name="{Binding Text, RelativeSource={RelativeSource Self}}"
               TextWrapping="Wrap"
               VerticalAlignment="Center" />
    <StackPanel Grid.Row="1"
                Orientation="Horizontal"
                HorizontalAlignment="Right"
                Spacing="8">
      <Button Content="{x:Static local:ApplicationStrings.CommandCancel}"
              AutomationProperties.Name="{x:Static local:ApplicationStrings.AutomationCancelExit}"
              IsCancel="True"
              Click="CancelButtonClick" />
      <Button Content="{x:Static local:ApplicationStrings.CommandExit}"
              AutomationProperties.Name="{x:Static local:ApplicationStrings.AutomationExitApplication}"
              IsDefault="True"
              Click="ExitButtonClick" />
    </StackPanel>
  </Grid>
</Window>
