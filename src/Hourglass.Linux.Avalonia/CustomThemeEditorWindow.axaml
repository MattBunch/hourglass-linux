<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Hourglass.Linux.Avalonia"
        x:Class="Hourglass.Linux.Avalonia.CustomThemeEditorWindow"
        Title="{x:Static local:ApplicationStrings.CustomThemeEditorTitle}"
        Icon="/Assets/hourglass.png"
        Width="420"
        Height="520"
        MinWidth="380"
        MinHeight="480"
        WindowStartupLocation="CenterOwner">
  <Grid Margin="18"
        RowDefinitions="*,Auto">
    <ScrollViewer>
      <StackPanel Spacing="10">
        <TextBlock Text="{x:Static local:ApplicationStrings.LabelName}" />
        <TextBox x:Name="NameBox"
                 AutomationProperties.Name="{x:Static local:ApplicationStrings.CustomThemeNameAutomation}" />
        <TextBlock Text="{x:Static local:ApplicationStrings.CustomThemeBaseThemeLabel}" />
        <ComboBox x:Name="BaseThemeBox"
                  AutomationProperties.Name="{x:Static local:ApplicationStrings.CustomThemeBaseThemeLabel}"
                  SelectedIndex="0">
          <ComboBoxItem Content="{x:Static local:ApplicationStrings.ThemeBaseSystem}" />
          <ComboBoxItem Content="{x:Static local:ApplicationStrings.ThemeBaseLight}" />
          <ComboBoxItem Content="{x:Static local:ApplicationStrings.ThemeBaseDark}" />
        </ComboBox>
        <TextBlock Text="{x:Static local:ApplicationStrings.LabelBackground}" />
        <TextBox x:Name="BackgroundBox"
                 AutomationProperties.Name="{x:Static local:ApplicationStrings.LabelBackgroundColor}" />
        <TextBlock Text="{x:Static local:ApplicationStrings.LabelPrimaryText}" />
        <TextBox x:Name="PrimaryTextBox"
                 AutomationProperties.Name="{x:Static local:ApplicationStrings.LabelPrimaryTextColor}" />
        <TextBlock Text="{x:Static local:ApplicationStrings.LabelSecondaryText}" />
        <TextBox x:Name="SecondaryTextBox"
                 AutomationProperties.Name="{x:Static local:ApplicationStrings.LabelSecondaryTextColor}" />
        <TextBlock Text="{x:Static local:ApplicationStrings.LabelCommandText}" />
        <TextBox x:Name="CommandTextBox"
                 AutomationProperties.Name="{x:Static local:ApplicationStrings.LabelCommandTextColor}" />
        <TextBlock Text="{x:Static local:ApplicationStrings.LabelAccent}" />
        <TextBox x:Name="AccentBox"
                 AutomationProperties.Name="{x:Static local:ApplicationStrings.LabelAccentColor}" />
        <TextBlock Text="{x:Static local:ApplicationStrings.LabelProgressFill}" />
        <TextBox x:Name="ProgressFillBox"
                 AutomationProperties.Name="{x:Static local:ApplicationStrings.LabelProgressFillColor}" />
        <TextBlock Text="{x:Static local:ApplicationStrings.LabelValidationFlash}" />
        <TextBox x:Name="ValidationFlashBox"
                 AutomationProperties.Name="{x:Static local:ApplicationStrings.LabelValidationFlashColor}" />
        <TextBlock Text="{x:Static local:ApplicationStrings.LabelCompletionBorder}" />
        <TextBox x:Name="CompletionBorderBox"
                 AutomationProperties.Name="{x:Static local:ApplicationStrings.LabelCompletionBorderColor}" />
        <TextBlock Text="{x:Static local:ApplicationStrings.LabelLockedBorder}" />
        <TextBox x:Name="LockedBorderBox"
                 AutomationProperties.Name="{x:Static local:ApplicationStrings.LabelLockedBorderColor}" />
        <TextBlock x:Name="ValidationText"
                   AutomationProperties.Name="{Binding Text, RelativeSource={RelativeSource Self}}"
                   AutomationProperties.LiveSetting="Polite"
                   Foreground="{DynamicResource SystemControlErrorTextForegroundBrush}"
                   TextWrapping="Wrap" />
      </StackPanel>
    </ScrollViewer>
    <StackPanel Grid.Row="1"
                Orientation="Horizontal"
                HorizontalAlignment="Right"
                Spacing="8"
                Margin="0 14 0 0">
      <Button Content="{x:Static local:ApplicationStrings.CommandCancel}"
              AutomationProperties.Name="{x:Static local:ApplicationStrings.AutomationCancelThemeEdit}"
              IsCancel="True"
              Click="CancelButtonClick" />
      <Button Content="{x:Static local:ApplicationStrings.CommandSave}"
              AutomationProperties.Name="{x:Static local:ApplicationStrings.AutomationSaveTheme}"
              IsDefault="True"
              Click="SaveButtonClick" />
    </StackPanel>
  </Grid>
</Window>
