<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Hourglass.Linux.Avalonia.CustomThemeEditorWindow"
        Title="Custom theme"
        Icon="/Assets/hourglass.png"
        Width="420"
        Height="520"
        MinWidth="380"
        MinHeight="480"
        WindowStartupLocation="CenterOwner">
  <Grid Margin="18"
        RowDefinitions="*,Auto">
    <ScrollViewer>
      <StackPanel Spacing="10">
        <TextBlock Text="Name" />
        <TextBox x:Name="NameBox"
                 AutomationProperties.Name="Theme name" />
        <TextBlock Text="Base theme" />
        <ComboBox x:Name="BaseThemeBox"
                  AutomationProperties.Name="Base theme"
                  SelectedIndex="0">
          <ComboBoxItem Content="System" />
          <ComboBoxItem Content="Light" />
          <ComboBoxItem Content="Dark" />
        </ComboBox>
        <TextBlock Text="Background" />
        <TextBox x:Name="BackgroundBox"
                 AutomationProperties.Name="Background color" />
        <TextBlock Text="Primary text" />
        <TextBox x:Name="PrimaryTextBox"
                 AutomationProperties.Name="Primary text color" />
        <TextBlock Text="Secondary text" />
        <TextBox x:Name="SecondaryTextBox"
                 AutomationProperties.Name="Secondary text color" />
        <TextBlock Text="Command text" />
        <TextBox x:Name="CommandTextBox"
                 AutomationProperties.Name="Command text color" />
        <TextBlock Text="Accent" />
        <TextBox x:Name="AccentBox"
                 AutomationProperties.Name="Accent color" />
        <TextBlock Text="Progress fill" />
        <TextBox x:Name="ProgressFillBox"
                 AutomationProperties.Name="Progress fill color" />
        <TextBlock Text="Validation flash" />
        <TextBox x:Name="ValidationFlashBox"
                 AutomationProperties.Name="Validation flash color" />
        <TextBlock Text="Completion border" />
        <TextBox x:Name="CompletionBorderBox"
                 AutomationProperties.Name="Completion border color" />
        <TextBlock Text="Locked border" />
        <TextBox x:Name="LockedBorderBox"
                 AutomationProperties.Name="Locked border color" />
        <TextBlock x:Name="ValidationText"
                   AutomationProperties.Name="Theme validation message"
                   Foreground="{DynamicResource SystemControlErrorTextForegroundBrush}"
                   TextWrapping="Wrap" />
      </StackPanel>
    </ScrollViewer>
    <StackPanel Grid.Row="1"
                Orientation="Horizontal"
                HorizontalAlignment="Right"
                Spacing="8"
                Margin="0 14 0 0">
      <Button Content="Cancel"
              AutomationProperties.Name="Cancel custom theme edit"
              IsCancel="True"
              Click="CancelButtonClick" />
      <Button Content="Save"
              AutomationProperties.Name="Save custom theme"
              IsDefault="True"
              Click="SaveButtonClick" />
    </StackPanel>
  </Grid>
</Window>
