<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Hourglass.Linux.Avalonia"
        x:Class="Hourglass.Linux.Avalonia.CustomThemeDeleteWindow"
        Title="{x:Static local:ApplicationStrings.CustomThemeDeleteTitle}"
        Icon="/Assets/hourglass.png"
        Width="360"
        Height="150"
        CanResize="False"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
  <Grid Margin="20"
        RowDefinitions="*,Auto">
    <TextBlock x:Name="MessageText"
               AutomationProperties.Name="{Binding Text, RelativeSource={RelativeSource Self}}"
               TextWrapping="Wrap"
               VerticalAlignment="Center" />
    <StackPanel Grid.Row="1"
                Orientation="Horizontal"
                HorizontalAlignment="Right"
                Spacing="8">
      <Button Content="{x:Static local:ApplicationStrings.CommandCancel}"
              AutomationProperties.Name="{x:Static local:ApplicationStrings.AutomationCancelThemeDelete}"
              IsCancel="True"
              Click="CancelButtonClick" />
      <Button Content="{x:Static local:ApplicationStrings.CommandDelete}"
              AutomationProperties.Name="{x:Static local:ApplicationStrings.AutomationDeleteTheme}"
              IsDefault="True"
              Click="DeleteButtonClick" />
    </StackPanel>
  </Grid>
</Window>
