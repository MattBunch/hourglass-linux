<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Hourglass.Linux.Avalonia"
        x:Class="Hourglass.Linux.Avalonia.AboutWindow"
        Title="{x:Static local:ApplicationStrings.AboutDialogTitle}"
        Icon="/Assets/hourglass.png"
        Width="460"
        Height="430"
        MinWidth="420"
        MinHeight="390"
        CanResize="False"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
  <Grid Margin="20"
        RowDefinitions="Auto,*,Auto">
    <StackPanel Orientation="Horizontal"
                Spacing="14">
      <Image Source="/Assets/hourglass.png"
             AutomationProperties.Name="{x:Static local:ApplicationStrings.AboutAutomationIcon}"
             Width="56"
             Height="56"
             VerticalAlignment="Top" />
      <StackPanel Spacing="2">
        <TextBlock x:Name="ProductNameText"
                   FontSize="22"
                   FontWeight="SemiBold"
                   TextWrapping="Wrap" />
        <TextBlock x:Name="DescriptionText"
                   TextWrapping="Wrap" />
      </StackPanel>
    </StackPanel>

    <ScrollViewer Grid.Row="1"
                  Margin="0,18,0,14"
                  VerticalScrollBarVisibility="Auto">
      <StackPanel Spacing="12">
        <Grid ColumnDefinitions="Auto,*"
              RowDefinitions="Auto,Auto,Auto,Auto,Auto"
              ColumnSpacing="16"
              RowSpacing="5">
          <TextBlock Text="{x:Static local:ApplicationStrings.LabelVersion}" />
          <TextBlock Grid.Column="1"
                     x:Name="VersionText"
                     TextWrapping="Wrap" />

          <TextBlock Grid.Row="1"
                     Text="{x:Static local:ApplicationStrings.LabelBuild}" />
          <TextBlock Grid.Row="1"
                     Grid.Column="1"
                     x:Name="BuildText"
                     TextWrapping="Wrap" />

          <TextBlock Grid.Row="2"
                     Text="{x:Static local:ApplicationStrings.LabelCommit}" />
          <TextBlock Grid.Row="2"
                     Grid.Column="1"
                     x:Name="CommitText"
                     TextWrapping="Wrap" />

          <TextBlock Grid.Row="3"
                     Text="{x:Static local:ApplicationStrings.LabelRuntime}" />
          <TextBlock Grid.Row="3"
                     Grid.Column="1"
                     x:Name="RuntimeText"
                     TextWrapping="Wrap" />

          <TextBlock Grid.Row="4"
                     Text="{x:Static local:ApplicationStrings.LabelPlatform}" />
          <TextBlock Grid.Row="4"
                     Grid.Column="1"
                     x:Name="PlatformText"
                     TextWrapping="Wrap" />
        </Grid>

        <TextBlock x:Name="DeveloperText"
                   TextWrapping="Wrap" />

        <StackPanel Spacing="6">
          <Button Content="{x:Static local:ApplicationStrings.AboutRepositoryButton}"
                  AutomationProperties.Name="{x:Static local:ApplicationStrings.AboutAutomationRepository}"
                  HorizontalAlignment="Left"
                  Click="RepositoryButtonClick" />
          <Button Content="{x:Static local:ApplicationStrings.AboutDeveloperWebsiteButton}"
                  AutomationProperties.Name="{x:Static local:ApplicationStrings.AboutAutomationDeveloperWebsite}"
                  HorizontalAlignment="Left"
                  Click="DeveloperWebsiteButtonClick" />
          <Button Content="{x:Static local:ApplicationStrings.AboutOriginalProjectButton}"
                  AutomationProperties.Name="{x:Static local:ApplicationStrings.AboutAutomationOriginalProject}"
                  HorizontalAlignment="Left"
                  Click="OriginalProjectButtonClick" />
          <TextBlock x:Name="LinkStatusText"
                     AutomationProperties.Name="{Binding Text, RelativeSource={RelativeSource Self}}"
                     AutomationProperties.LiveSetting="Polite"
                     Foreground="{DynamicResource ThemeForegroundLowBrush}"
                     TextWrapping="Wrap" />
        </StackPanel>

        <TextBlock x:Name="LicenseText"
                   TextWrapping="Wrap" />
      </StackPanel>
    </ScrollViewer>

    <Grid Grid.Row="2"
          ColumnDefinitions="*,Auto"
          ColumnSpacing="8">
      <StackPanel Orientation="Horizontal"
                  VerticalAlignment="Center"
                  Spacing="10">
        <Button Content="{x:Static local:ApplicationStrings.AboutAutomationCopyBuildInformation}"
                AutomationProperties.Name="{x:Static local:ApplicationStrings.AboutAutomationCopyBuildInformation}"
                Click="CopyBuildInformationButtonClick" />
        <TextBlock x:Name="CopyStatusText"
                   AutomationProperties.Name="{Binding Text, RelativeSource={RelativeSource Self}}"
                   AutomationProperties.LiveSetting="Polite"
                   VerticalAlignment="Center"
                   TextWrapping="Wrap" />
      </StackPanel>
      <Button Grid.Column="1"
              Content="{x:Static local:ApplicationStrings.CommandClose}"
              AutomationProperties.Name="{x:Static local:ApplicationStrings.AboutAutomationClose}"
              IsCancel="True"
              Click="CloseButtonClick" />
    </Grid>
  </Grid>
</Window>
