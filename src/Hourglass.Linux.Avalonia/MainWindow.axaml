<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Hourglass.Linux.Avalonia"
        x:Class="Hourglass.Linux.Avalonia.MainWindow"
        x:DataType="local:MainWindowViewModel"
        Title="{Binding WindowTitle}"
        Icon="/Assets/hourglass.png"
        Topmost="{Binding AlwaysOnTop}"
        Width="350"
        Height="150"
        MinWidth="250"
        MinHeight="150">
  <Window.Resources>
    <local:ProgressWidthConverter x:Key="ProgressWidthConverter" />
    <SolidColorBrush x:Key="TimerWindowBackgroundBrush"
                     Color="Transparent" />
    <SolidColorBrush x:Key="TimerPrimaryTextBrush"
                     Color="#FF1F1F1F" />
    <SolidColorBrush x:Key="TimerSecondaryTextBrush"
                     Color="#B31F1F1F" />
    <SolidColorBrush x:Key="TimerCommandTextBrush"
                     Color="#FF1F1F1F" />
    <SolidColorBrush x:Key="TimerAccentBrush"
                     Color="#FF3665B3" />
    <SolidColorBrush x:Key="TimerValidationFlashBrush"
                     Color="#29D13438" />
    <SolidColorBrush x:Key="TimerCompletionBorderBrush"
                     Color="#FF3665B3" />
    <SolidColorBrush x:Key="TimerLockedBorderBrush"
                     Color="#661F1F1F" />
    <SolidColorBrush x:Key="TimerProgressFillBrush"
                     Color="#3665B3"
                     Opacity="0.45" />
  </Window.Resources>

  <Window.Styles>
    <Style Selector="Grid.progressTrack">
      <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundBaseLowBrush}" />
    </Style>

    <Style Selector="TextBox.timerInput">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="FontFamily" Value="Segoe UI Light, Inter, Noto Sans, sans-serif" />
      <Setter Property="Foreground" Value="{DynamicResource TextControlForeground}" />
      <Setter Property="CaretBrush" Value="{DynamicResource TextControlForeground}" />
    </Style>

    <Style Selector="TextBox.titleInput">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="FontFamily" Value="Segoe UI, Inter, Noto Sans, sans-serif" />
      <Setter Property="Foreground" Value="{DynamicResource TextControlForeground}" />
      <Setter Property="CaretBrush" Value="{DynamicResource TextControlForeground}" />
      <Setter Property="Opacity" Value="0.72" />
    </Style>

    <Style Selector="TextBox.titleInput:focus">
      <Setter Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
      <Setter Property="BorderThickness" Value="0 0 0 1" />
      <Setter Property="Opacity" Value="1" />
    </Style>

    <Style Selector="TextBox.timerInput:focus">
      <Setter Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
      <Setter Property="BorderThickness" Value="0 0 0 1" />
    </Style>

    <Style Selector="TextBox.timerInput.validation-error">
      <Setter Property="BorderBrush" Value="{DynamicResource SystemControlErrorTextForegroundBrush}" />
      <Setter Property="BorderThickness" Value="0 0 0 2" />
    </Style>

    <Style Selector="TextBox.timerInput.validation-feedback">
      <Setter Property="Background" Value="{DynamicResource TimerValidationFlashBrush}" />
    </Style>

    <Style Selector="Border#CompletionEmphasisBorder">
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="3" />
    </Style>

    <Style Selector="Grid.timer-expired Border#CompletionEmphasisBorder">
      <Setter Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
      <Setter Property="BorderThickness" Value="2" />
    </Style>

    <Style Selector="Grid.timer-locked Border#CompletionEmphasisBorder">
      <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseMediumLowBrush}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style Selector="Border#ExpiryFlashLayer">
      <Setter Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
      <Setter Property="Opacity" Value="0" />
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity"
                            Duration="0:0:0.18"
                            Easing="QuadraticEaseOut" />
        </Transitions>
      </Setter>
    </Style>

    <Style Selector="Grid.timer-expiry-flash Border#ExpiryFlashLayer">
      <Setter Property="Opacity" Value="0.22" />
    </Style>

    <Style Selector="Button.textCommand">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="7 0" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="FontFamily" Value="Segoe UI, Inter, Noto Sans, sans-serif" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{DynamicResource TextControlForeground}" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>

    <Style Selector="Button.textCommand:pointerover">
      <Setter Property="Foreground" Value="{DynamicResource AccentFillColorDefaultBrush}" />
    </Style>

    <Style Selector="Grid.custom-theme Grid.progressTrack">
      <Setter Property="Background" Value="{DynamicResource TimerWindowBackgroundBrush}" />
    </Style>

    <Style Selector="Grid.custom-theme TextBox.timerInput">
      <Setter Property="Foreground" Value="{DynamicResource TimerPrimaryTextBrush}" />
      <Setter Property="CaretBrush" Value="{DynamicResource TimerPrimaryTextBrush}" />
    </Style>

    <Style Selector="Grid.custom-theme TextBox.titleInput">
      <Setter Property="Foreground" Value="{DynamicResource TimerSecondaryTextBrush}" />
      <Setter Property="CaretBrush" Value="{DynamicResource TimerSecondaryTextBrush}" />
    </Style>

    <Style Selector="Grid.custom-theme TextBox.titleInput:focus">
      <Setter Property="BorderBrush" Value="{DynamicResource TimerAccentBrush}" />
    </Style>

    <Style Selector="Grid.custom-theme TextBox.timerInput:focus">
      <Setter Property="BorderBrush" Value="{DynamicResource TimerAccentBrush}" />
    </Style>

    <Style Selector="Grid.custom-theme TextBox.timerInput.validation-feedback">
      <Setter Property="Background" Value="{DynamicResource TimerValidationFlashBrush}" />
    </Style>

    <Style Selector="Grid.custom-theme.timer-expired Border#CompletionEmphasisBorder">
      <Setter Property="BorderBrush" Value="{DynamicResource TimerCompletionBorderBrush}" />
    </Style>

    <Style Selector="Grid.custom-theme.timer-locked Border#CompletionEmphasisBorder">
      <Setter Property="BorderBrush" Value="{DynamicResource TimerLockedBorderBrush}" />
    </Style>

    <Style Selector="Grid.custom-theme Border#ExpiryFlashLayer">
      <Setter Property="Background" Value="{DynamicResource TimerAccentBrush}" />
    </Style>

    <Style Selector="Grid.custom-theme Button.textCommand">
      <Setter Property="Foreground" Value="{DynamicResource TimerCommandTextBrush}" />
    </Style>

    <Style Selector="Grid.custom-theme Button.textCommand:pointerover">
      <Setter Property="Foreground" Value="{DynamicResource TimerAccentBrush}" />
    </Style>

    <Style Selector="Button.textCommand:pressed">
      <Setter Property="Opacity" Value="0.72" />
    </Style>

    <Style Selector="StackPanel#CommandPanel">
      <Setter Property="Opacity" Value="1" />
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity"
                            Duration="0:0:0.3"
                            Easing="QuadraticEaseOut" />
        </Transitions>
      </Setter>
    </Style>

    <Style Selector="Grid.timer-active:not(.content-active) StackPanel#CommandPanel">
      <Setter Property="Opacity" Value="0.08" />
    </Style>
  </Window.Styles>

  <Grid x:Name="RootGrid"
        Background="Transparent"
        Classes="content-active">
    <Grid.ContextMenu>
      <ContextMenu>
        <MenuItem Header="New timer"
                  Command="{Binding NewTimerCommand}" />
        <MenuItem Header="Start"
                  Command="{Binding StartCommand}" />
        <MenuItem Header="{Binding PauseResumeText}"
                  Command="{Binding PauseResumeCommand}" />
        <MenuItem Header="Stop"
                  Command="{Binding ResetCommand}" />
        <MenuItem Header="Restart"
                  Command="{Binding RestartCommand}" />
        <MenuItem x:Name="RecentInputsMenuItem"
                  Header="Recent inputs" />
        <MenuItem x:Name="SavedTimersMenuItem"
                  Header="Saved timers" />
        <Separator />
        <MenuItem Header="Notifications"
                  ToggleType="CheckBox"
                  IsChecked="{Binding NotificationsEnabled, Mode=OneWay}"
                  Command="{Binding ToggleNotificationsCommand}" />
        <MenuItem Header="Sound">
          <MenuItem Header="None"
                    ToggleType="Radio"
                    GroupName="AudioAlertSound"
                    IsChecked="{Binding IsNoSoundSelected, Mode=OneWay}"
                    Command="{Binding SelectAudioAlertSoundCommand}"
                    CommandParameter="none" />
          <MenuItem Header="Loud beep"
                    ToggleType="Radio"
                    GroupName="AudioAlertSound"
                    IsChecked="{Binding IsLoudBeepSoundSelected, Mode=OneWay}"
                    Command="{Binding SelectAudioAlertSoundCommand}"
                    CommandParameter="resource:Loud beep" />
          <MenuItem Header="Normal beep"
                    ToggleType="Radio"
                    GroupName="AudioAlertSound"
                    IsChecked="{Binding IsNormalBeepSoundSelected, Mode=OneWay}"
                    Command="{Binding SelectAudioAlertSoundCommand}"
                    CommandParameter="resource:Normal beep" />
          <MenuItem Header="Quiet beep"
                    ToggleType="Radio"
                    GroupName="AudioAlertSound"
                    IsChecked="{Binding IsQuietBeepSoundSelected, Mode=OneWay}"
                    Command="{Binding SelectAudioAlertSoundCommand}"
                    CommandParameter="resource:Quiet beep" />
          <Separator />
          <MenuItem Header="Preview selected sound"
                    Command="{Binding PreviewAudioAlertSoundCommand}" />
          <MenuItem Header="Stop preview"
                    Command="{Binding StopAudioAlertPreviewCommand}" />
        </MenuItem>
        <MenuItem Header="Pop up when expired"
                  ToggleType="CheckBox"
                  IsChecked="{Binding PopUpWhenExpired, Mode=OneWay}"
                  Command="{Binding TogglePopUpWhenExpiredCommand}" />
        <MenuItem Header="Always on top"
                  ToggleType="CheckBox"
                  IsChecked="{Binding AlwaysOnTop, Mode=OneWay}"
                  Command="{Binding ToggleAlwaysOnTopCommand}" />
        <MenuItem Header="Show progress in taskbar"
                  ToggleType="CheckBox"
                  IsChecked="{Binding ShowProgressInTaskbar, Mode=OneWay}"
                  Command="{Binding ToggleShowProgressInTaskbarCommand}" />
        <MenuItem Header="Show in notification area"
                  ToggleType="CheckBox"
                  IsChecked="{Binding ShowInNotificationArea, Mode=OneWay}"
                  IsEnabled="{Binding IsStatusIconSupported}"
                  Command="{Binding ToggleShowInNotificationAreaCommand}" />
        <MenuItem Header="Prompt on exit"
                  ToggleType="CheckBox"
                  IsChecked="{Binding PromptOnExit, Mode=OneWay}"
                  Command="{Binding TogglePromptOnExitCommand}" />
        <MenuItem x:Name="ThemeMenuItem"
                  Header="Theme" />
        <MenuItem Header="Window title">
          <MenuItem Header="Application name"
                    ToggleType="Radio"
                    GroupName="WindowTitleMode"
                    IsChecked="{Binding IsApplicationNameTitleModeSelected, Mode=OneWay}"
                    Command="{Binding SelectWindowTitleModeCommand}"
                    CommandParameter="ApplicationName" />
          <MenuItem Header="Time left"
                    ToggleType="Radio"
                    GroupName="WindowTitleMode"
                    IsChecked="{Binding IsTimeLeftTitleModeSelected, Mode=OneWay}"
                    Command="{Binding SelectWindowTitleModeCommand}"
                    CommandParameter="TimeLeft" />
          <MenuItem Header="Time elapsed"
                    ToggleType="Radio"
                    GroupName="WindowTitleMode"
                    IsChecked="{Binding IsTimeElapsedTitleModeSelected, Mode=OneWay}"
                    Command="{Binding SelectWindowTitleModeCommand}"
                    CommandParameter="TimeElapsed" />
          <MenuItem Header="Timer title"
                    ToggleType="Radio"
                    GroupName="WindowTitleMode"
                    IsChecked="{Binding IsTimerTitleModeSelected, Mode=OneWay}"
                    Command="{Binding SelectWindowTitleModeCommand}"
                    CommandParameter="TimerTitle" />
          <MenuItem Header="Time left plus timer title"
                    ToggleType="Radio"
                    GroupName="WindowTitleMode"
                    IsChecked="{Binding IsTimeLeftPlusTimerTitleModeSelected, Mode=OneWay}"
                    Command="{Binding SelectWindowTitleModeCommand}"
                    CommandParameter="TimeLeftPlusTimerTitle" />
          <MenuItem Header="Time elapsed plus timer title"
                    ToggleType="Radio"
                    GroupName="WindowTitleMode"
                    IsChecked="{Binding IsTimeElapsedPlusTimerTitleModeSelected, Mode=OneWay}"
                    Command="{Binding SelectWindowTitleModeCommand}"
                    CommandParameter="TimeElapsedPlusTimerTitle" />
          <MenuItem Header="Timer title plus time left"
                    ToggleType="Radio"
                    GroupName="WindowTitleMode"
                    IsChecked="{Binding IsTimerTitlePlusTimeLeftModeSelected, Mode=OneWay}"
                    Command="{Binding SelectWindowTitleModeCommand}"
                    CommandParameter="TimerTitlePlusTimeLeft" />
          <MenuItem Header="Timer title plus time elapsed"
                    ToggleType="Radio"
                    GroupName="WindowTitleMode"
                    IsChecked="{Binding IsTimerTitlePlusTimeElapsedModeSelected, Mode=OneWay}"
                    Command="{Binding SelectWindowTitleModeCommand}"
                    CommandParameter="TimerTitlePlusTimeElapsed" />
        </MenuItem>
        <MenuItem Header="Advanced options">
          <MenuItem Header="Reverse progress bar"
                    ToggleType="CheckBox"
                    IsChecked="{Binding ReverseProgressBar, Mode=OneWay}"
                    Command="{Binding ToggleReverseProgressBarCommand}" />
          <MenuItem Header="Show time elapsed"
                    ToggleType="CheckBox"
                    IsChecked="{Binding ShowTimeElapsed, Mode=OneWay}"
                    Command="{Binding ToggleShowTimeElapsedCommand}" />
          <MenuItem Header="Loop timer"
                    ToggleType="CheckBox"
                    IsChecked="{Binding LoopTimer, Mode=OneWay}"
                    Command="{Binding ToggleLoopTimerCommand}" />
          <MenuItem Header="Loop sound"
                    ToggleType="CheckBox"
                    IsChecked="{Binding LoopSound, Mode=OneWay}"
                    Command="{Binding ToggleLoopSoundCommand}" />
          <MenuItem Header="Close when expired"
                    ToggleType="CheckBox"
                    IsChecked="{Binding CloseWhenExpired, Mode=OneWay}"
                    Command="{Binding ToggleCloseWhenExpiredCommand}" />
          <MenuItem Header="Lock interface"
                    ToggleType="CheckBox"
                    IsChecked="{Binding LockInterface, Mode=OneWay}"
                    Command="{Binding ToggleLockInterfaceCommand}" />
          <MenuItem Header="Do not keep computer awake"
                    ToggleType="CheckBox"
                    IsChecked="{Binding DoNotKeepComputerAwake, Mode=OneWay}"
                    Command="{Binding ToggleDoNotKeepComputerAwakeCommand}" />
          <MenuItem Header="Shut down when expired"
                    ToggleType="CheckBox"
                    IsChecked="{Binding ShutDownWhenExpired, Mode=OneWay}"
                    IsEnabled="{Binding IsShutdownSupported}"
                    Command="{Binding ToggleShutDownWhenExpiredCommand}" />
          <MenuItem Header="Restore active session on startup"
                    ToggleType="CheckBox"
                    IsChecked="{Binding RestoreActiveSessionOnStartup, Mode=OneWay}"
                    Command="{Binding ToggleRestoreActiveSessionOnStartupCommand}" />
          <MenuItem Header="Open saved timers on startup"
                    ToggleType="CheckBox"
                    IsChecked="{Binding OpenSavedTimersOnStartup, Mode=OneWay}"
                    Command="{Binding ToggleOpenSavedTimersOnStartupCommand}" />
        </MenuItem>
        <MenuItem x:Name="FullScreenMenuItem"
                  Header="Full screen"
                  ToggleType="CheckBox"
                  Click="FullScreenMenuItemClick" />
        <Separator />
        <MenuItem Header="Hide to notification area"
                  IsEnabled="{Binding CanHideToNotificationArea}"
                  Command="{Binding HideToNotificationAreaCommand}" />
        <Separator />
        <MenuItem Header="About Hourglass"
                  Click="AboutMenuItemClick" />
        <MenuItem Header="Exit"
                  Click="ExitMenuItemClick" />
      </ContextMenu>
    </Grid.ContextMenu>

    <Border x:Name="ExpiryFlashLayer"
            ZIndex="3"
            IsHitTestVisible="False" />

    <Border x:Name="CompletionEmphasisBorder"
            ZIndex="2"
            IsHitTestVisible="False" />

    <Grid x:Name="ProgressLayer"
          ZIndex="0"
          Classes="progressTrack"
          ClipToBounds="True"
          IsHitTestVisible="False">
      <Border x:Name="ProgressIndicator"
              HorizontalAlignment="Left"
              Background="{DynamicResource TimerProgressFillBrush}">
        <Border.Width>
          <MultiBinding Converter="{StaticResource ProgressWidthConverter}">
            <Binding Path="ProgressPercent" />
            <Binding ElementName="ProgressLayer"
                     Path="Bounds.Width" />
          </MultiBinding>
        </Border.Width>
      </Border>
    </Grid>

    <Grid x:Name="InnerGrid"
          ZIndex="1"
          Margin="10"
          PointerEntered="InnerGridPointerEntered"
          PointerExited="InnerGridPointerExited"
          GotFocus="InnerGridFocusChanged"
          LostFocus="InnerGridFocusChanged">
      <StackPanel x:Name="ControlsPanel"
                  Margin="20 0"
                  VerticalAlignment="Center"
                  Spacing="4">
        <local:ResponsiveTextBox x:Name="TimerTitleTextBox"
                                 Classes="titleInput"
                                 AutomationProperties.Name="Timer title"
                                 AutomationProperties.HelpText="Optional title for this timer."
                                 Text="{Binding TimerTitle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 PlaceholderText="Click to enter title"
                                 MinFontSize="8"
                                 MaxFontSize="12"
                                 GotFocus="TimerTitleTextBoxGotFocus" />

        <Grid x:Name="PrimaryTextGrid"
              MinHeight="42">
          <local:ResponsiveTextBox x:Name="TimerInputTextBox"
                                   Classes="timerInput"
                                   AutomationProperties.Name="Timer input"
                                   AutomationProperties.HelpText="Enter a duration or time, then press Enter to start."
                                   Text="{Binding TimerInput, Mode=TwoWay}"
                                   IsVisible="{Binding IsTimerInputVisible}"
                                   PlaceholderText="5 minutes"
                                   MinFontSize="8"
                                   MaxFontSize="18">
            <local:ResponsiveTextBox.KeyBindings>
              <KeyBinding Gesture="Return"
                          Command="{Binding StartCommand}" />
              <KeyBinding Gesture="Enter"
                          Command="{Binding StartCommand}" />
            </local:ResponsiveTextBox.KeyBindings>
          </local:ResponsiveTextBox>

          <local:ResponsiveTextBox x:Name="RemainingTimeTextBox"
                                   Classes="timerInput"
                                   AutomationProperties.Name="Remaining time"
                                   AutomationProperties.HelpText="Shows the active timer time. Focus to edit the timer."
                                   Text="{Binding RemainingTime, Mode=OneWay}"
                                   IsReadOnly="True"
                                   IsVisible="{Binding IsRemainingTimeVisible}"
                                   Cursor="Arrow"
                                   MinFontSize="8"
                                   MaxFontSize="18"
                                   GotFocus="RemainingTimeTextBoxGotFocus"
                                   PointerPressed="RemainingTimeTextBoxPointerPressed" />

          <local:ResponsiveTextBox x:Name="CompletionTextBox"
                                   Classes="timerInput"
                                   AutomationProperties.Name="Timer status"
                                   AutomationProperties.HelpText="Shows completion or validation status. Focus to dismiss completion."
                                   Text="{Binding StatusText, Mode=OneWay}"
                                   IsReadOnly="True"
                                   IsVisible="{Binding IsCompletionTextVisible}"
                                   Cursor="Arrow"
                                   MinFontSize="8"
                                   MaxFontSize="18"
                                   GotFocus="CompletionTextBoxGotFocus"
                                   PointerPressed="CompletionTextBoxPointerPressed" />
        </Grid>

        <StackPanel x:Name="CommandPanel"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Spacing="0">
          <Button x:Name="StartButton"
                  Classes="textCommand"
                  AutomationProperties.Name="Start timer"
                  Content="Start"
                  Command="{Binding StartCommand}"
                  IsVisible="{Binding IsStartVisible}" />
          <Button x:Name="PauseButton"
                  Classes="textCommand"
                  AutomationProperties.Name="Pause timer"
                  Content="Pause"
                  Command="{Binding PauseResumeCommand}"
                  IsVisible="{Binding IsPauseVisible}" />
          <Button x:Name="ResumeButton"
                  Classes="textCommand"
                  AutomationProperties.Name="Resume timer"
                  Content="Resume"
                  Command="{Binding PauseResumeCommand}"
                  IsVisible="{Binding IsResumeVisible}" />
          <Button x:Name="StopButton"
                  Classes="textCommand"
                  AutomationProperties.Name="Stop timer"
                  Content="Stop"
                  Command="{Binding ResetCommand}"
                  IsVisible="{Binding IsStopVisible}" />
          <Button x:Name="RestartButton"
                  Classes="textCommand"
                  AutomationProperties.Name="Restart timer"
                  Content="Restart"
                  Command="{Binding RestartCommand}"
                  IsVisible="{Binding IsRestartVisible}" />
          <Button x:Name="CancelButton"
                  Classes="textCommand"
                  AutomationProperties.Name="Cancel timer edit"
                  Content="Cancel"
                  Command="{Binding CancelEditCommand}"
                  IsVisible="{Binding IsCancelVisible}" />
        </StackPanel>
      </StackPanel>
    </Grid>
  </Grid>
</Window>
