<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Hourglass.Linux.Avalonia"
        x:Class="Hourglass.Linux.Avalonia.MainWindow"
        x:DataType="local:MainWindowViewModel"
        Title="{Binding WindowTitle}"
        Topmost="{Binding AlwaysOnTop}"
        Width="350"
        Height="150"
        MinWidth="250"
        MinHeight="150">
  <Window.Resources>
    <local:ProgressWidthConverter x:Key="ProgressWidthConverter" />
    <SolidColorBrush x:Key="TimerProgressFillBrush"
                     Color="#3665B3"
                     Opacity="0.45" />
    <SolidColorBrush x:Key="ValidationFlashBrush"
                     Color="#D13438"
                     Opacity="0.16" />
  </Window.Resources>

  <Window.Styles>
    <Style Selector="Grid.progressTrack">
      <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundBaseLowBrush}" />
    </Style>

    <Style Selector="TextBox.timerInput">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="FontFamily" Value="Segoe UI Light, Inter, Noto Sans, sans-serif" />
      <Setter Property="Foreground" Value="{DynamicResource TextControlForeground}" />
      <Setter Property="CaretBrush" Value="{DynamicResource TextControlForeground}" />
    </Style>

    <Style Selector="TextBox.titleInput">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="FontFamily" Value="Segoe UI, Inter, Noto Sans, sans-serif" />
      <Setter Property="Foreground" Value="{DynamicResource TextControlForeground}" />
      <Setter Property="CaretBrush" Value="{DynamicResource TextControlForeground}" />
      <Setter Property="Opacity" Value="0.72" />
    </Style>

    <Style Selector="TextBox.titleInput:focus">
      <Setter Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
      <Setter Property="BorderThickness" Value="0 0 0 1" />
      <Setter Property="Opacity" Value="1" />
    </Style>

    <Style Selector="TextBox.timerInput:focus">
      <Setter Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
      <Setter Property="BorderThickness" Value="0 0 0 1" />
    </Style>

    <Style Selector="TextBox.timerInput.validation-error">
      <Setter Property="BorderBrush" Value="{DynamicResource SystemControlErrorTextForegroundBrush}" />
      <Setter Property="BorderThickness" Value="0 0 0 2" />
    </Style>

    <Style Selector="TextBox.timerInput.validation-feedback">
      <Setter Property="Background" Value="{StaticResource ValidationFlashBrush}" />
    </Style>

    <Style Selector="Border#CompletionEmphasisBorder">
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="3" />
    </Style>

    <Style Selector="Grid.timer-expired Border#CompletionEmphasisBorder">
      <Setter Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
      <Setter Property="BorderThickness" Value="2" />
    </Style>

    <Style Selector="Border#ExpiryFlashLayer">
      <Setter Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
      <Setter Property="Opacity" Value="0" />
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity"
                            Duration="0:0:0.18"
                            Easing="QuadraticEaseOut" />
        </Transitions>
      </Setter>
    </Style>

    <Style Selector="Grid.timer-expiry-flash Border#ExpiryFlashLayer">
      <Setter Property="Opacity" Value="0.22" />
    </Style>

    <Style Selector="Button.textCommand">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="7 0" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="FontFamily" Value="Segoe UI, Inter, Noto Sans, sans-serif" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{DynamicResource TextControlForeground}" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>

    <Style Selector="Button.textCommand:pointerover">
      <Setter Property="Foreground" Value="{DynamicResource AccentFillColorDefaultBrush}" />
    </Style>

    <Style Selector="Button.textCommand:pressed">
      <Setter Property="Opacity" Value="0.72" />
    </Style>

    <Style Selector="StackPanel#CommandPanel">
      <Setter Property="Opacity" Value="1" />
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity"
                            Duration="0:0:0.3"
                            Easing="QuadraticEaseOut" />
        </Transitions>
      </Setter>
    </Style>

    <Style Selector="Grid.timer-active:not(.content-active) StackPanel#CommandPanel">
      <Setter Property="Opacity" Value="0.08" />
    </Style>
  </Window.Styles>

  <Grid x:Name="RootGrid"
        Background="Transparent"
        Classes="content-active">
    <Grid.ContextMenu>
      <ContextMenu>
        <MenuItem Header="Start"
                  Command="{Binding StartCommand}" />
        <MenuItem Header="{Binding PauseResumeText}"
                  Command="{Binding PauseResumeCommand}" />
        <MenuItem Header="Stop"
                  Command="{Binding ResetCommand}" />
        <Separator />
        <MenuItem Header="Notifications"
                  ToggleType="CheckBox"
                  IsChecked="{Binding NotificationsEnabled, Mode=OneWay}"
                  Command="{Binding ToggleNotificationsCommand}" />
        <MenuItem Header="Sound"
                  ToggleType="CheckBox"
                  IsChecked="{Binding AudioAlertsEnabled, Mode=OneWay}"
                  Command="{Binding ToggleAudioAlertsCommand}" />
        <MenuItem Header="Pop up when expired"
                  ToggleType="CheckBox"
                  IsChecked="{Binding PopUpWhenExpired, Mode=OneWay}"
                  Command="{Binding TogglePopUpWhenExpiredCommand}" />
        <MenuItem Header="Always on top"
                  ToggleType="CheckBox"
                  IsChecked="{Binding AlwaysOnTop, Mode=OneWay}"
                  Command="{Binding ToggleAlwaysOnTopCommand}" />
        <Separator />
        <MenuItem Header="Exit"
                  Click="ExitMenuItemClick" />
      </ContextMenu>
    </Grid.ContextMenu>

    <Border x:Name="ExpiryFlashLayer"
            IsHitTestVisible="False" />

    <Border x:Name="CompletionEmphasisBorder"
            IsHitTestVisible="False" />

    <Grid x:Name="ProgressLayer"
          Classes="progressTrack"
          ClipToBounds="True"
          IsHitTestVisible="False">
      <Border x:Name="ProgressIndicator"
              HorizontalAlignment="Left"
              Background="{StaticResource TimerProgressFillBrush}">
        <Border.Width>
          <MultiBinding Converter="{StaticResource ProgressWidthConverter}">
            <Binding Path="ProgressPercent" />
            <Binding ElementName="ProgressLayer"
                     Path="Bounds.Width" />
          </MultiBinding>
        </Border.Width>
      </Border>
    </Grid>

    <Grid x:Name="InnerGrid"
          Margin="10"
          PointerEntered="InnerGridPointerEntered"
          PointerExited="InnerGridPointerExited"
          GotFocus="InnerGridFocusChanged"
          LostFocus="InnerGridFocusChanged">
      <StackPanel x:Name="ControlsPanel"
                  Margin="20 0"
                  VerticalAlignment="Center"
                  Spacing="4">
        <local:ResponsiveTextBox x:Name="TimerTitleTextBox"
                                 Classes="titleInput"
                                 Text="{Binding TimerTitle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 PlaceholderText="Click to enter title"
                                 MinFontSize="8"
                                 MaxFontSize="12"
                                 GotFocus="TimerTitleTextBoxGotFocus" />

        <Grid x:Name="PrimaryTextGrid"
              MinHeight="42">
          <local:ResponsiveTextBox x:Name="TimerInputTextBox"
                                   Classes="timerInput"
                                   Text="{Binding TimerInput, Mode=TwoWay}"
                                   IsVisible="{Binding IsTimerInputVisible}"
                                   PlaceholderText="5 minutes"
                                   MinFontSize="8"
                                   MaxFontSize="18">
            <local:ResponsiveTextBox.KeyBindings>
              <KeyBinding Gesture="Return"
                          Command="{Binding StartCommand}" />
              <KeyBinding Gesture="Enter"
                          Command="{Binding StartCommand}" />
              <KeyBinding Gesture="Escape"
                          Command="{Binding CancelEditCommand}" />
            </local:ResponsiveTextBox.KeyBindings>
          </local:ResponsiveTextBox>

          <local:ResponsiveTextBox x:Name="RemainingTimeTextBox"
                                   Classes="timerInput"
                                   Text="{Binding RemainingTime, Mode=OneWay}"
                                   IsReadOnly="True"
                                   IsVisible="{Binding IsRemainingTimeVisible}"
                                   MinFontSize="8"
                                   MaxFontSize="18"
                                   GotFocus="RemainingTimeTextBoxGotFocus"
                                   PointerPressed="RemainingTimeTextBoxPointerPressed" />

          <local:ResponsiveTextBox x:Name="CompletionTextBox"
                                   Classes="timerInput"
                                   Text="{Binding StatusText, Mode=OneWay}"
                                   IsReadOnly="True"
                                   IsVisible="{Binding IsCompletionTextVisible}"
                                   MinFontSize="8"
                                   MaxFontSize="18"
                                   GotFocus="CompletionTextBoxGotFocus"
                                   PointerPressed="CompletionTextBoxPointerPressed" />
        </Grid>

        <StackPanel x:Name="CommandPanel"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Spacing="0">
          <Button x:Name="StartButton"
                  Classes="textCommand"
                  Content="Start"
                  Command="{Binding StartCommand}"
                  IsVisible="{Binding IsStartVisible}" />
          <Button x:Name="PauseButton"
                  Classes="textCommand"
                  Content="Pause"
                  Command="{Binding PauseResumeCommand}"
                  IsVisible="{Binding IsPauseVisible}" />
          <Button x:Name="ResumeButton"
                  Classes="textCommand"
                  Content="Resume"
                  Command="{Binding PauseResumeCommand}"
                  IsVisible="{Binding IsResumeVisible}" />
          <Button x:Name="StopButton"
                  Classes="textCommand"
                  Content="Stop"
                  Command="{Binding ResetCommand}"
                  IsVisible="{Binding IsStopVisible}" />
          <Button x:Name="CancelButton"
                  Classes="textCommand"
                  Content="Cancel"
                  Command="{Binding CancelEditCommand}"
                  IsVisible="{Binding IsCancelVisible}" />
        </StackPanel>
      </StackPanel>
    </Grid>
  </Grid>
</Window>
