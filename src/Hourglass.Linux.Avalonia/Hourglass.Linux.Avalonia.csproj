<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>hourglass-linux</AssemblyName>
    <RootNamespace>Hourglass.Linux.Avalonia</RootNamespace>
    <Version>0.1.0</Version>
    <RuntimeIdentifiers>linux-x64</RuntimeIdentifiers>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.0.4" />
    <PackageReference Include="Avalonia.Desktop" Version="12.0.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.0.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Hourglass.Core\Hourglass.Core.csproj" />
    <ProjectReference Include="..\Hourglass.Platform\Hourglass.Platform.csproj" />
    <ProjectReference Include="..\Hourglass.Linux.Services\Hourglass.Linux.Services.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\hourglass.png" />
    <AvaloniaResource Include="Assets\hourglass.svg" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\Sounds\BeepNormal.wav">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>
</Project>
